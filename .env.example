# ─────────────────────────────────────────────────────────────────────────────
# Diva configuration. Copy to .env.local and fill in what you have.
# Everything is optional: with nothing set, Diva runs in DEMO MODE with local
# sample data in .diva-data/ (git-ignored). Integrations you leave blank show a
# clear "not configured" state — nothing is faked.
# ─────────────────────────────────────────────────────────────────────────────

# App
APP_URL=http://localhost:3000            # used for links inside reminder emails
APP_TIMEZONE=Asia/Kolkata                # default timezone for new profiles

# Supabase (auth + Postgres + private file storage). Run supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=               # server-only; used by the reminder scheduler

# AI (server-only). Set ONE key; the provider is picked automatically (or force AI_PROVIDER=anthropic|openai|gemini).
AI_PROVIDER=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=                                # optional override (defaults: claude-sonnet-5-5 / gemini-3.8-flash)
AI_FALLBACK_MODEL=                       # optional second model tried when the first is overloaded
AI_BASE_URL=                             # optional, for a compatible gateway/proxy

# Email reminders via Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="Diva <reminders@your-verified-domain.com>"
DEMO_REMINDER_EMAIL=                     # demo mode only: where reminder emails go

# Scheduler — protects GET /api/cron/reminders (send as "Authorization: Bearer <secret>")
CRON_SECRET=

# GitHub (optional) — lets Diva import & analyse PRIVATE repos and raises rate limits.
# Create at https://github.com/settings/personal-access-tokens (fine-grained):
#   Repository access: All repositories · Permissions (read-only): Contents, Metadata, Issues
GITHUB_TOKEN=
